# Local backups, generated work and previous publication checkouts
/archive/
/build/
/arm/build/
/fpga/build/
/fpga/archive/
.venv/
__pycache__/
*.py[cod]

# Large reproducible FPGA inputs and local reports with machine paths
/fpga/sim/data/*/
/fpga/doc/avm/validation/
/fpga/doc/avm/pds-validation/
/fpga/doc/avm/*.json
/fpga/doc/avm/*.png
/fpga/doc/reference/
/fpga/doc/history/
/arm/doc/history/

# Imported binary assets require an explicit distribution decision
/arm/models/*.rknn
/arm/third_party/rknn/lib/*.so*
/arm/drivers/prebuilt/*.ko
!/arm/drivers/prebuilt/pango_pci_driver_mul.ko

# Tool outputs outside their intended build directories
*.o
*.obj
*.wlf
*.vcd
*.ucdb
*.jou
transcript
modelsim.ini
.qmake.stash
Makefile
Makefile.*
moc_*.cpp
ui_*.h

# Local credentials, settings and session state
.env
.env.*
*.pem
*.key
*.lic
.codex/
.claude/
*.user
*.user.*

# Restricted vendor SDK header and one-time local maintenance
/arm/third_party/rknn/include/rknn_api.h
/tools/maintenance/
/fpga/doc/avm/figures/
/fpga/doc/avm/*report.md
/fpga/doc/avm/pds-validation.md
