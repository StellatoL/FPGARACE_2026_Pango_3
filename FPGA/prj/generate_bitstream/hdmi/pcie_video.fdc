# Camera PCLKs use ordinary IO pins; allow non-dedicated clock routing.
# Check post-route setup/hold timing before hardware use.
define_attribute {n:cmos_pclk} {PAP_CLOCK_DEDICATED_ROUTE} {FALSE}
define_attribute {n:cmos2_pclk} {PAP_CLOCK_DEDICATED_ROUTE} {FALSE}
define_attribute {n:cmos3_pclk} {PAP_CLOCK_DEDICATED_ROUTE} {FALSE}
define_attribute {n:cmos4_pclk} {PAP_CLOCK_DEDICATED_ROUTE} {FALSE}
create_clock -name {cmos3_pclk} [get_ports {cmos3_pclk}] -period {20.830} -waveform {0.000 10.415}
#create_clock -name {cmos2_pclk} [get_ports {cmos2_pclk}] -period {11.900} -waveform {0.000 5.950}
#create_generated_clock -name {cmos3_pclk_16bit} -source [get_ports {cmos3_pclk}] [get_pins {cmos3_8_16bit/pixel_clk}] -master_clock [get_clocks {cmos3_pclk}] -multiply_by {1} -divide_by {2}
#create_generated_clock -name {cmos2_pclk_16bit} -source [get_ports {cmos2_pclk}] [get_pins {cmos2_8_16bit/pixel_clk}] -master_clock [get_clocks {cmos2_pclk}] -multiply_by {1} -divide_by {2}
#set_clock_uncertainty {0.200} [get_clocks {cmos3_pclk_16bit}]  -setup -hold
#set_clock_uncertainty {0.200} [get_clocks {cmos2_pclk_16bit}]  -setup -hold
set_clock_uncertainty {0.200} [get_clocks {cmos3_pclk}]  -setup -hold

set_clock_groups -name cmos3_pclk -asynchronous -group [get_clocks {cmos3_pclk}]

# The remaining camera ports are intentionally left without LOC assignments.
# Fill in the LOC for every signal after consulting the board schematic.  The
# port names and electrical standards stay stable, so only these bindings need
# to change when a camera connector is selected.
# define_attribute {p:cmos_pclk}  {PAP_IO_LOC} {<CAM1_PCLK_PIN>}
# define_attribute {p:cmos2_pclk} {PAP_IO_LOC} {<CAM2_PCLK_PIN>}
# define_attribute {p:cmos4_pclk} {PAP_IO_LOC} {<CAM4_PCLK_PIN>}
# Required signals for each manual binding:
#   cmos[_n]_scl, cmos[_n]_sda, cmos[_n]_reset,
#   cmos[_n]_pclk, cmos[_n]_vsync, cmos[_n]_href,
#   cmos[_n]_data[0] ... cmos[_n]_data[7]
# Use the same PAP_IO_VCCIO/IO_STANDARD/DRIVE/SLEW attributes as cmos3_*
# below; only PAP_IO_LOC should differ for each physical connector.
create_clock -name {cmos_pclk}  [get_ports {cmos_pclk}]  -period {20.830} -waveform {0.000 10.415}
create_clock -name {cmos2_pclk} [get_ports {cmos2_pclk}] -period {20.830} -waveform {0.000 10.415}
create_clock -name {cmos4_pclk} [get_ports {cmos4_pclk}] -period {20.830} -waveform {0.000 10.415}
set_clock_uncertainty {0.200} [get_clocks {cmos_pclk}]  -setup -hold
set_clock_uncertainty {0.200} [get_clocks {cmos2_pclk}] -setup -hold
set_clock_uncertainty {0.200} [get_clocks {cmos4_pclk}] -setup -hold
set_clock_groups -name cmos_pclk  -asynchronous -group [get_clocks {cmos_pclk}]
set_clock_groups -name cmos2_pclk -asynchronous -group [get_clocks {cmos2_pclk}]
set_clock_groups -name cmos4_pclk -asynchronous -group [get_clocks {cmos4_pclk}]


#???V1.0?·Ú??HDMI?????????????19??174??183?????
#???V1.1?·Ú??HDMI????????????19??174??183??????????pixclk_in????????W19??b_in[1]????????w20

create_clock -name {pix_clk_in} [get_ports {pixclk_in}] -period {6.670} -waveform {0.000 3.335}
set_clock_uncertainty {0.200} [get_clocks {pix_clk_in}] -setup -hold

# HDMI RX (MS7200) source-synchronous input: 24-bit RGB plus DE/HS/VS.
# The receiver already inverts PCLK (reg 0x1281=0x04), so the FPGA samples
# near the centre of the data eye. Values below are initial placeholders;
# replace them with the MS7200 DVO tCO and PCB skew measured on the board.
set_input_delay -clock [get_clocks {pix_clk_in}] -max 2.000 [get_ports {r_in[0] r_in[1] r_in[2] r_in[3] r_in[4] r_in[5] r_in[6] r_in[7] g_in[0] g_in[1] g_in[2] g_in[3] g_in[4] g_in[5] g_in[6] g_in[7] b_in[0] b_in[1] b_in[2] b_in[3] b_in[4] b_in[5] b_in[6] b_in[7] de_in hs_in vs_in}]
set_input_delay -clock [get_clocks {pix_clk_in}] -min 0.500 [get_ports {r_in[0] r_in[1] r_in[2] r_in[3] r_in[4] r_in[5] r_in[6] r_in[7] g_in[0] g_in[1] g_in[2] g_in[3] g_in[4] g_in[5] g_in[6] g_in[7] b_in[0] b_in[1] b_in[2] b_in[3] b_in[4] b_in[5] b_in[6] b_in[7] de_in hs_in vs_in}]

